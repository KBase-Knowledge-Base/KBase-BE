# Copy to .env for Docker Compose and export the same variables before Maven runs.
# Fill values through a secret mechanism; never commit .env or production credentials.

# Local dependency image references. PostgreSQL is pgvector-capable for M1+.
KBASE_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg17-bookworm
KBASE_MINIO_IMAGE=quay.io/minio/minio:latest
KBASE_REDIS_IMAGE=redis:7.4-alpine

# AI runtime foundation (disabled by default; API key is optional until a provider adapter is approved)
KBASE_AI_ENABLED=false
KBASE_AI_GEMINI_API_KEY=
KBASE_AI_GEMINI_CHAT_MODEL=gemini-2.5-flash
KBASE_AI_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
KBASE_AI_GEMINI_EMBEDDING_DIMENSIONS=768
KBASE_AI_PROVIDER_CONNECT_TIMEOUT=10s
KBASE_AI_PROVIDER_REQUEST_TIMEOUT=60s
KBASE_AI_MAX_MESSAGE_CHARS=8000
KBASE_AI_CHUNK_TARGET_TOKENS=700
KBASE_AI_CHUNK_OVERLAP_PERCENT=12
KBASE_AI_RETRIEVAL_CANDIDATE_LIMIT=10
KBASE_AI_RETRIEVAL_FINAL_CONTEXT_LIMIT=6
# M10 selected 0.70 from deterministic fixture evaluation; blank remains a fail-closed test override.
KBASE_AI_RETRIEVAL_SIMILARITY_THRESHOLD=0.70
KBASE_AI_WORKER_POLL_INTERVAL=5s
KBASE_AI_WORKER_BATCH_SIZE=10
KBASE_AI_WORKER_LEASE_TIMEOUT=2m
KBASE_AI_WORKER_RETRY_BACKOFF=30s
KBASE_AI_WORKER_MAX_ATTEMPTS=3
KBASE_AI_RETENTION=7d
KBASE_AI_USAGE_RATE_NAMESPACE=kbase:ai:rate
KBASE_AI_USAGE_MAX_REQUESTS=20
KBASE_AI_USAGE_WINDOW=1m

# PostgreSQL (required for local Compose and backend startup)
KBASE_POSTGRES_DB=
KBASE_POSTGRES_USERNAME=
KBASE_POSTGRES_PASSWORD=
KBASE_POSTGRES_HOST=localhost
KBASE_POSTGRES_PORT=5432

# Redis OTP store (password is optional for the local skeleton)
KBASE_REDIS_HOST=localhost
KBASE_REDIS_PORT=6379
KBASE_REDIS_PASSWORD=
KBASE_REDIS_TIMEOUT=2s

# MinIO (required for the storage adapter in later milestones)
KBASE_STORAGE_ENDPOINT=http://localhost:9000
KBASE_STORAGE_ACCESS_KEY=
KBASE_STORAGE_SECRET_KEY=
KBASE_STORAGE_BUCKET=kbase-documents
KBASE_STORAGE_REGION=us-east-1
KBASE_STORAGE_AUTO_CREATE=true
KBASE_STORAGE_INITIALIZE_ON_STARTUP=true
KBASE_STORAGE_CONNECT_TIMEOUT=5s
KBASE_STORAGE_WRITE_TIMEOUT=30s
KBASE_STORAGE_READ_TIMEOUT=30s
KBASE_STORAGE_API_PORT=9000
KBASE_STORAGE_CONSOLE_PORT=9001

# JWT, OTP and refresh-cookie settings
KBASE_JWT_SECRET=
KBASE_OTP_HASH_SECRET=
KBASE_OTP_LENGTH=6
KBASE_OTP_TTL=5m
KBASE_OTP_RESEND_COOLDOWN=60s
KBASE_OTP_MAX_ATTEMPTS=5
KBASE_ACCESS_TOKEN_TTL=15m
KBASE_REFRESH_TOKEN_TTL=7d
KBASE_REFRESH_COOKIE_NAME=kbase_refresh_token
KBASE_REFRESH_COOKIE_SECURE=false
KBASE_REFRESH_COOKIE_SAME_SITE=Lax
KBASE_REFRESH_COOKIE_MAX_AGE=7d
KBASE_REFRESH_COOKIE_PATH=/api/v1/auth

# Local mail double for automated Docker runtime verification (docker-compose.mail-test.yml).
# Start it with: docker compose -f docker-compose.yml -f docker-compose.mail-test.yml up -d mail-test
# then point the backend at it via KBASE_GMAIL_SMTP_HOST=mail-test KBASE_GMAIL_SMTP_PORT=1025
# KBASE_GMAIL_SMTP_AUTH=false KBASE_GMAIL_SMTP_STARTTLS=false. Real deployments keep Gmail values.

# Gmail SMTP (required when mail adapters are implemented)
KBASE_GMAIL_SMTP_HOST=smtp.gmail.com
KBASE_GMAIL_SMTP_PORT=587
KBASE_GMAIL_SMTP_USERNAME=
KBASE_GMAIL_SMTP_APP_PASSWORD=
KBASE_GMAIL_SMTP_AUTH=true
KBASE_GMAIL_SMTP_STARTTLS=true
KBASE_GMAIL_SMTP_TIMEOUT=10s
KBASE_SMTP_CONNECTION_TIMEOUT_MS=10000
KBASE_SMTP_TIMEOUT_MS=10000
KBASE_SMTP_WRITE_TIMEOUT_MS=10000

# Core v1 policy/configuration
KBASE_INVITATION_EXPIRATION=72h
KBASE_INVITATION_ACCEPT_URL=http://localhost:3000/invitations/accept
KBASE_UPLOAD_DOCUMENT_MAX_SIZE=50MB
KBASE_UPLOAD_IMAGE_MAX_SIZE=20MB
KBASE_UPLOAD_VIDEO_MAX_SIZE=500MB
KBASE_UPLOAD_MAX_BATCH_FILES=10
KBASE_ALLOWED_ORIGINS=http://localhost:3000
KBASE_SERVER_PORT=8080
KBASE_OPENAPI_ENABLED=true
KBASE_SWAGGER_UI_ENABLED=true
KBASE_MULTIPART_MAX_REQUEST_SIZE=500MB
KBASE_DB_CONNECTION_TIMEOUT_MS=5000
